// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// NOTE: SQLite doesn't support Json or enum types.
// We use String fields with application-level validation.
// Switch to postgresql provider for production deployment.

// ── Users ──────────────────────────────────────────────────────
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String   // bcrypt hash (SHA-256 in dev)
  role      String   @default("CANDIDATE") // CANDIDATE | PROCTOR
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  candidateSessions Session[] @relation("CandidateSessions")
  proctorSessions   Session[] @relation("ProctorSessions")
  consents          Consent[]
  appeals           Appeal[]
  dataRequests      DataRequest[]

  @@map("users")
}

// ── Sessions ───────────────────────────────────────────────────
model Session {
  id        String @id @default(uuid())
  joinCode  String @unique @map("join_code") // 6-char uppercase
  status    String @default("CREATED") // SessionStatus values

  candidateId String? @map("candidate_id")
  proctorId   String  @map("proctor_id")

  candidate User? @relation("CandidateSessions", fields: [candidateId], references: [id])
  proctor   User  @relation("ProctorSessions", fields: [proctorId], references: [id])

  // Meeting URL — encrypted at rest, never sent to candidate UI
  meetingUrl String? @map("meeting_url")

  // Risk scoring
  riskScore   Float  @default(0) @map("risk_score")
  riskWeights String @default("{}") @map("risk_weights") // JSON string — per-session overrides

  // Session config (gaze thresholds, blocklist, etc.)
  config String @default("{}") @map("config") // JSON string

  // ── Accommodations (Phase 9: Fairness) ──
  // JSON array of Accommodation objects from shared/privacy.ts
  accommodations String @default("[]") @map("accommodations")
  // Free-text note about candidate's accessibility needs
  accommodationNote String? @map("accommodation_note")

  // ── Retention (Phase 9: Privacy) ──
  // JSON string of RetentionPolicy overrides
  retentionPolicy String @default("{}") @map("retention_policy")
  // When this session's data should be purged (computed from endedAt + policy)
  retainUntil DateTime? @map("retain_until")
  // Whether data has been anonymised/deleted
  dataErased Boolean @default(false) @map("data_erased")

  // Timestamps
  consentAt DateTime? @map("consent_at")
  startedAt DateTime? @map("started_at")
  endedAt   DateTime? @map("ended_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  // Relations
  events  Event[]
  appeals Appeal[]

  @@index([joinCode])
  @@index([status])
  @@index([proctorId])
  @@index([retainUntil])
  @@map("sessions")
}

// ── Events ─────────────────────────────────────────────────────
model Event {
  id        String   @id @default(uuid()) // server-side UUID
  eventId   String   @unique @map("event_id") // client-generated UUID for dedup
  sessionId String   @map("session_id")

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  type     String // EventType from shared package
  severity String // EventSeverity: INFO | WARNING | CRITICAL
  source   String // EventSource: CANDIDATE_APP | BACKEND | PROCTOR | ANALYSIS_SERVICE

  // Client-side timestamp vs server arrival
  clientTimestamp DateTime  @map("client_timestamp")
  serverTimestamp DateTime  @default(now()) @map("server_timestamp")

  // Optional fields
  confidence  Float?  @map("confidence")
  metadata    String  @default("{}") @map("metadata") // JSON string
  evidenceRef String? @map("evidence_ref") // MinIO object key

  // Review state
  reviewStatus String  @default("UNREVIEWED") @map("review_status")
  proctorNote  String? @map("proctor_note")

  // ── AI Disclosure (Phase 9) ──
  // Whether this flag was generated by an algorithmic system
  algorithmicFlag Boolean @default(true) @map("algorithmic_flag")

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  appeals Appeal[]

  @@index([sessionId])
  @@index([sessionId, type])
  @@index([serverTimestamp])
  @@map("events")
}

// ── Consent Records (Phase 9: GDPR/DPDP) ──────────────────────
model Consent {
  id        String @id @default(uuid())
  userId    String @map("user_id")
  sessionId String @map("session_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // What the consent covers
  purpose       String  // ConsentPurpose from shared/privacy.ts
  status        String  @default("GRANTED") // GRANTED | WITHDRAWN
  policyVersion String  @default("1.0") @map("policy_version")
  ipHash        String? @map("ip_hash") // SHA-256 of IP, not raw IP

  grantedAt   DateTime  @default(now()) @map("granted_at")
  withdrawnAt DateTime? @map("withdrawn_at")

  @@index([userId])
  @@index([sessionId])
  @@map("consents")
}

// ── Appeals (Phase 9: Fairness) ────────────────────────────────
model Appeal {
  id        String @id @default(uuid())
  sessionId String @map("session_id")
  eventId   String @map("event_id")
  userId    String @map("user_id") // Candidate who submitted

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  candidateStatement String @map("candidate_statement")
  status             String @default("SUBMITTED") // AppealStatus
  proctorResponse    String? @map("proctor_response")

  submittedAt DateTime  @default(now()) @map("submitted_at")
  resolvedAt  DateTime? @map("resolved_at")

  @@index([sessionId])
  @@index([eventId])
  @@index([userId])
  @@map("appeals")
}

// ── Data Subject Requests (GDPR Art 15-17, DPDP Sec 11-14) ────
model DataRequest {
  id     String @id @default(uuid())
  userId String @map("user_id")

  user User @relation(fields: [userId], references: [id])

  // EXPORT or ERASURE
  type   String // 'EXPORT' | 'ERASURE'
  status String @default("PENDING") // PENDING | PROCESSING | COMPLETED | REJECTED

  // What scopes were requested
  scope String @default("[]") @map("scope") // JSON array of scope strings

  // Processing timestamps
  requestedAt  DateTime  @default(now()) @map("requested_at")
  processingAt DateTime? @map("processing_at")
  completedAt  DateTime? @map("completed_at")

  // For EXPORT: download URL (presigned, time-limited)
  downloadUrl String? @map("download_url")
  // For ERASURE: what was deleted + any retention reason
  deletedScopes   String? @map("deleted_scopes") // JSON array
  retentionReason String? @map("retention_reason")

  @@index([userId])
  @@index([status])
  @@map("data_requests")
}
