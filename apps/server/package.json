{
  "name": "@proctoroverlay/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "clean": "rimraf dist",
    "test": "pnpm test:voice && node tests/test-e2e.mjs && node tests/test-scenarios.mjs && node tests/test-false-positives.mjs",
    "test:voice": "node --import tsx tests/test-voice-provider.mjs",
    "test:e2e": "node tests/test-e2e.mjs",
    "test:scenarios": "node tests/test-scenarios.mjs",
    "test:fp": "node tests/test-false-positives.mjs"
  },
  "dependencies": {
    "@proctoroverlay/shared": "workspace:*",
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/websocket": "^10.0.1",
    "@prisma/client": "^5.20.0",
    "fastify": "^4.28.1",
    "socket.io": "^4.8.0",
    "minio": "^8.0.1",
    "ioredis": "^5.4.1",
    "bullmq": "^5.17.0",
    "dotenv": "^16.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "prisma": "^5.20.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
